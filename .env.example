SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Newer Supabase projects may show this as SUPABASE_SECRET_KEY instead.
# SUPABASE_SECRET_KEY=your-secret-key
