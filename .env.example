# SUPABASE_STORAGE_BUCKET=player-lead-images

# Optional: private admin page at /admin/leads.
ADMIN_ACCESS_TOKEN=choose-a-long-private-password

# Optional: send a member email confirmation link after signup.
RESEND_API_KEY=your-resend-api-key
WELCOME_EMAIL_FROM=NLDEVS <hello@nldevs.ca>
WELCOME_EMAIL_REPLY_TO=nldevsmtl@gmail.com
NEW_MEMBER_NOTIFY_EMAIL=nldevsmtl@gmail.com
